MERIDIAN_ENVIRONMENT=development
MERIDIAN_APP_NAME=Meridian API
MERIDIAN_APP_VERSION=0.1.0
MERIDIAN_API_V1_PREFIX=/api/v1
MERIDIAN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
MERIDIAN_DATABASE_ECHO=false
MERIDIAN_SUPABASE_URL=http://127.0.0.1:54321
MERIDIAN_SUPABASE_JWT_AUDIENCE=authenticated
MERIDIAN_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

MERIDIAN_GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
MERIDIAN_GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
MERIDIAN_GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/v1/calendar/google/callback

MERIDIAN_TOKEN_ENCRYPTION_KEY=generate-with-python-c-from-cryptography-fernet-import-Fernet-print-Fernet-generate-key-decode
# Optional: separate HS256 secret for OAuth state JWT; defaults to TOKEN_ENCRYPTION_KEY if not set
# MERIDIAN_GOOGLE_OAUTH_STATE_SECRET=your-random-state-secret
