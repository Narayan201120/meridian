{
  "name": "meridian-frontend",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "e2e": "bun run e2e:demo && bun run e2e:live",
    "e2e:demo": "playwright test -c playwright.demo.config.ts",
    "e2e:live": "playwright test -c playwright.config.ts",
    "e2e:headed": "playwright test -c playwright.demo.config.ts --headed",
    "e2e:clean": "pwsh -NoProfile -File ./scripts/free-e2e-ports.ps1"
  },
  "dependencies": {
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "clsx": "^2.1.1",
    "expo": "~55.0.31",
    "expo-font": "~55.0.8",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "lucide-react-native": "^1.33.0",
    "nativewind": "^4.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-web": "^0.21.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3.4.18"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "sharp": "^0.35.4",
    "typescript": "^5.0.0"
  }
}
